22. To-Do List Application
<!DOCTYPE html>
<html>
<head>
<script>
function addTask(){
var task=document.getElementById("task").value;
var li=document.createElement("li");
li.innerHTML=task;
document.getElementById("list").appendChild(li);
}
</script>
</head>
<body>
<input type="text" id="task">
<button onclick="addTask()">Add</button>
<ul id="list"></ul>
</body>
</html>
